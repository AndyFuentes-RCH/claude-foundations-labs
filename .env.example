# Copia este archivo como .env y completa solo lo que vayas a usar.
# .env está en .gitignore: nunca lo subas al repositorio.

# --- Comportamiento general -------------------------------------------------
# Proveedor por defecto en la interfaz: mock | anthropic | vertex | bedrock
CFL_DEFAULT_PROVIDER=mock
# Interruptor de consumo facturable. Con "false" ninguna llamada real sale de la máquina,
# aunque haya credenciales configuradas (los proveedores reales quedan en PENDIENTE).
CFL_ALLOW_LIVE_CALLS=false
# Límite de iteraciones del bucle de tool use (Proyecto 2)
CFL_MAX_TOOL_ITERATIONS=5
# Esfuerzo del modelo: low | medium | high | xhigh | max
CFL_EFFORT=medium
CFL_MAX_TOKENS=16000
# Latencia simulada del "core de remesas" sintético, en milisegundos (demostración del Proyecto 4)
CFL_SIMULATED_LATENCY_MS=0
# Directorio donde se registran las ejecuciones
CFL_EVIDENCE_DIR=docs/evidence

# --- Proyecto 2: Claude API (Anthropic) -------------------------------------
ANTHROPIC_API_KEY=
CFL_ANTHROPIC_MODEL=claude-opus-5-5
# Fallback de servidor ante rechazos (solo disponible en la Claude API)
CFL_ENABLE_SERVER_FALLBACKS=true

# --- Proyecto 5: Claude en Google Cloud Vertex AI ---------------------------
# La autenticación usa Application Default Credentials:
#   gcloud auth application-default login
ANTHROPIC_VERTEX_PROJECT_ID=
# global (recomendado) | us | eu
CLOUD_ML_REGION=global
CFL_VERTEX_MODEL=claude-opus-5-5
# Opcional: ruta a una cuenta de servicio (no la subas al repositorio)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Proyecto 6: Claude en Amazon Bedrock -----------------------------------
AWS_REGION=us-east-1
# Usa un perfil de ~/.aws/config (recomendado, p. ej. SSO o rol asumido)...
AWS_PROFILE=
# ...o un bearer token de corta duración generado con aws-bedrock-token-generator
AWS_BEARER_TOKEN_BEDROCK=
# ID del modelo en Bedrock o un inference profile / ARN
CFL_BEDROCK_MODEL=anthropic.claude-opus-5-5
